{
    "mcpServers": {
      "playwright": {
        "command": "npx",
        "args": [
          "@playwright/mcp@latest"
        ]
      }
    },
    "airbnb": {
        "command": "npx",
        "args": [
          "-y",
          "@openbnb/mcp-server-airbnb",
          "--ignore-robots-txt"
        ]
      },
      "ddg-search": {
            "command": "npx",
        "args": [
          "-y",
          "duckduckgo-mcp-server"
        ]
      }
  }